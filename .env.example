# Variables understood by programs that build their timemachine context with
# Builder::from_env() or run_main(). The `tm` CLI sets them for you; set them
# by hand only to drive a program without tm. Leave all unset for normal runs.

# live (default) | record | replay | drive
TM_MODE=record
# Only the context with this test name obeys the other variables (optional).
TM_TEST=flaky_cache
# Seed for simulated sources when recording (default 0).
TM_SEED=7
# sim | real — override the sources the program configured (record only).
TM_SOURCES=sim
# Trace to write (record, drive) or read (replay).
TM_TRACE=tm-out/run.tmtrace
# JSON array of decisions, e.g. [1, 0, 3] (drive only).
# TM_DECISIONS=decisions.json
# Where to write a JSON run report (optional).
# TM_REPORT=report.json
# Largest trace file to load, in bytes (default 1073741824 = 1 GiB). Not set by
# tm; it is inherited from your shell and honoured by tm and by the program.
# TM_MAX_TRACE_BYTES=4294967296
